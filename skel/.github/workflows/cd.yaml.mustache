name: Continuous Delivery

on: push

jobs:
  verify:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        node: [ '24', '26' ]
    name: verify using node v${{ matrix.node }}
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-node@v7
        with:
          node-version: ${{ matrix.node }}
          cache: 'npm'
      - run: npm ci
      - run: npm run verify
      - uses: actions/upload-artifact@v7
        if: ${{ always() }}
        with:
          name: coverage (node v${{ matrix.node }})
          path: coverage/
      # Type-checking no longer emits, so build here to catch diagnostics that only
      # surface during declaration emit (e.g. private names in exported API).
      - run: npm run build

  publish:
    needs: verify
    runs-on: ubuntu-latest
    name: publish package if needed
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-node@v7
        with:
          node-version: 24
          cache: 'npm'
      - run: npm ci
      # semantic-release is intentionally not a devDependency — it is a large tree that
      # every `npm ci` would pay for while only this job ever runs it. Pin the majors here
      # so the release step stays reproducible. semantic-release does not bundle the
      # conventionalcommits preset that `.releaserc.json` names (the default angular preset
      # cannot parse `feat!:` headers), so it is installed beside it in the same `npx` call.
      - run: npx --yes -p semantic-release@25 -p conventional-changelog-conventionalcommits@9 semantic-release
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          NPM_TOKEN: ${{ secrets.<<package.publishTokenSecretName>> }}
