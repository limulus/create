{
  "name": "{{#pacakge.scope}}@{{{.}}}/{{/pacakge.scope}}{{{package.name}}}",
  "version": "1.0.0",
  "description": "{{package.description}}",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": ["dist", "src"],
  "type": "module",
  "scripts": {
    "prebuild": "npm run clean",
    "build": "concurrently -c auto 'npm:build:*'",
    "build:cjs": "tsc --incremental false --module commonjs --outDir dist/cjs",
    "build:dts": "tsc --incremental false --declaration --declarationMap --emitDeclarationOnly --outDir dist/types",
    "build:esm": "tsc --incremental false --outDir dist/esm",
    "build:cjs:pkg": "mkdirp dist/cjs && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "clean": "del *.tsbuildinfo coverage dist",
    "lint": "eslint *.js src",
    "prepack": "npm run build",
    "prepare": "is-ci || husky install",
    "test": "cross-env NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --coverage",
    "tscc": "tsc --noEmit",
    "verify": "concurrently -c cyan,magenta,blue npm:lint npm:test npm:tscc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limulus/{{package.name}}.git"
  },
  "author": {
    "name": "Eric McCarthy",
    "email": "eric@unallocated.com",
    "url": "https://unallocated.com/"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/limulus/{{package.name}}/issues"
  },
  "homepage": "https://github.com/limulus/{{package.name}}#readme",
  "dependencies": {
    "tslib": "^2.4.1"
  },
  "publishConfig": {
    "registry": "{{ package.publishRegistry }}"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.3.0",
    "@commitlint/config-conventional": "^17.3.0",
    "@limulus/eslint-config": "^4.1.0",
    "@swc/jest": "^0.2.24",
    "@types/jest": "^29.2.4",
    "@types/node": "^18.11.18",
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "del-cli": "^5.0.0",
    "eslint": "^8.30.0",
    "husky": "^8.0.2",
    "is-ci": "^3.0.1",
    "jest": "^29.3.1",
    "mkdirp": "^1.0.4",
    "prettier": "^2.8.1",
    "semantic-release": "^19.0.5",
    "typescript": "^4.9.4"
  }
}
