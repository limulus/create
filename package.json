{
  "name": "@limulus/create",
  "version": "1.0.0",
  "description": "Create a TypeScript npm package or project",
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/bin/create.js",
  "files": [
    "dist",
    "skel"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "npm run clean",
    "build": "node node_modules/typescript-7/bin/tsc --build tsconfig.build.json",
    "clean": "del-cli *.tsbuildinfo coverage dist",
    "lint": "eslint . --config eslint.config.js --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "prepack": "npm run build",
    "prepare": "is-ci || husky",
    "test": "vitest run --coverage",
    "test:skel": "node scripts/checkSkeleton.ts",
    "tscc": "node node_modules/typescript-7/bin/tsc --build",
    "verify": "concurrently -c cyan,magenta,blue npm:lint npm:test npm:tscc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limulus/create.git"
  },
  "author": {
    "name": "Eric McCarthy",
    "email": "eric@limulus.net",
    "url": "https://limulus.net/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/limulus/create/issues"
  },
  "homepage": "https://github.com/limulus/create#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@danieldietrich/copy": "^0.4.2",
    "@sindresorhus/is": "^8.1.0",
    "hosted-git-info": "^9.0.3",
    "mustache": "^4.2.0",
    "parse-author": "^2.0.0",
    "simple-git": "^4.1.0",
    "validate-npm-package-name": "^7.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@limulus/eslint-config": "^6.2.1",
    "@types/hosted-git-info": "^3.0.5",
    "@types/mustache": "^4.2.6",
    "@types/node": "^24.19.2",
    "@types/parse-author": "^2.0.3",
    "@types/touch": "^3.1.5",
    "@types/validate-npm-package-name": "^4.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "concurrently": "^10.0.7",
    "del": "^9.0.1",
    "del-cli": "^8.0.1",
    "eslint": "^10.15.0",
    "get-stream": "^9.0.1",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "tempy": "^3.2.0",
    "touch": "^3.1.1",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "^5.1.1"
  }
}
