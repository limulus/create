{
  "name": "@unallocate/create",
  "version": "1.0.0",
  "description": "Create a TypeScript npm package or project",
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/bin/create.js",
  "files": [
    "dist",
    "skel"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc",
    "clean": "del *.tsbuildinfo coverage dist",
    "lint": "eslint *.js src skel",
    "prepack": "npm run build",
    "prepare": "is-ci || husky install",
    "test": "cross-env NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --coverage",
    "tscc": "tsc --noEmit",
    "verify": "concurrently -c cyan,magenta,blue npm:lint npm:test npm:tscc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unallocate/create.git"
  },
  "author": {
    "name": "Eric McCarthy",
    "email": "eric@unallocated.com",
    "url": "https://unallocated.com/"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/unallocate/create/issues"
  },
  "homepage": "https://github.com/unallocate/create#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@danieldietrich/copy": "^0.4.2",
    "@sindresorhus/is": "^6.1.0",
    "mustache": "^4.2.0",
    "simple-git": "^3.20.0",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.2.0",
    "@commitlint/config-conventional": "^18.1.0",
    "@limulus/eslint-config": "^5.0.0",
    "@swc/jest": "^0.2.29",
    "@types/jest": "^29.5.6",
    "@types/mustache": "^4.2.4",
    "@types/node": "^20.8.9",
    "@types/nodegit": "^0.28.6",
    "@types/touch": "^3.1.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "del": "^7.1.0",
    "del-cli": "^5.1.0",
    "eslint": "^8.52.0",
    "husky": "^8.0.3",
    "is-ci": "^3.0.1",
    "jest": "^29.7.0",
    "mkdirp": "^3.0.1",
    "semantic-release": "^22.0.5",
    "tempy": "^3.1.0",
    "touch": "^3.1.0",
    "typescript": "^5.2.2"
  }
}
