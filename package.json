{
  "name": "@unallocate/create",
  "version": "1.0.0",
  "description": "Create a TypeScript npm package or project",
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/bin/create.js",
  "files": [
    "dist",
    "skel"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc",
    "clean": "del *.tsbuildinfo coverage dist",
    "postinstall": "patch-package",
    "lint": "eslint *.ts src",
    "prepack": "npm run build",
    "prepare": "is-ci || husky",
    "test": "vitest run --coverage",
    "tscc": "tsc --noEmit",
    "verify": "concurrently -c cyan,magenta,blue npm:lint npm:test npm:tscc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unallocate/create.git"
  },
  "author": {
    "name": "Eric McCarthy",
    "email": "eric@limulus.net",
    "url": "https://limulus.net/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/unallocate/create/issues"
  },
  "homepage": "https://github.com/unallocate/create#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@danieldietrich/copy": "^0.4.2",
    "@sindresorhus/is": "^7.0.1",
    "mustache": "^4.2.0",
    "patch-package": "^8.0.0",
    "simple-git": "^3.27.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@limulus/eslint-config": "^5.2.0",
    "@types/mustache": "^4.2.5",
    "@types/node": "^22.13.10",
    "@types/touch": "^3.1.5",
    "@vitest/coverage-v8": "^3.0.9",
    "concurrently": "^9.1.2",
    "del": "^8.0.0",
    "del-cli": "^6.0.0",
    "eslint": "^8.52.0",
    "get-stream": "^9.0.1",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "mkdirp": "^3.0.1",
    "semantic-release": "^24.2.3",
    "tempy": "^3.1.0",
    "touch": "^3.1.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
