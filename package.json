{
  "name": "@unallocate/create",
  "version": "1.0.0",
  "description": "Create a TypeScript npm package or project",
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/bin/create.js",
  "files": [
    "dist",
    "skel"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc",
    "clean": "del *.tsbuildinfo coverage dist",
    "lint": "eslint *.js src skel",
    "prepack": "npm run build",
    "prepare": "is-ci || husky install",
    "test": "cross-env NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --coverage",
    "tscc": "tsc --noEmit",
    "verify": "concurrently -c cyan,magenta,blue npm:lint npm:test npm:tscc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unallocate/create.git"
  },
  "author": {
    "name": "Eric McCarthy",
    "email": "eric@unallocated.com",
    "url": "https://unallocated.com/"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/unallocate/create/issues"
  },
  "homepage": "https://github.com/unallocate/create#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@danieldietrich/copy": "^0.4.2",
    "@sindresorhus/is": "^5.3.0",
    "mustache": "^4.2.0",
    "nodegit": "^0.28.0-alpha.18",
    "tslib": "^2.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.3.0",
    "@commitlint/config-conventional": "^17.3.0",
    "@limulus/eslint-config": "^4.1.0",
    "@swc/jest": "^0.2.24",
    "@types/jest": "^29.2.4",
    "@types/mustache": "^4.2.2",
    "@types/node": "^18.11.18",
    "@types/nodegit": "^0.27.10",
    "@types/touch": "^3.1.2",
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "del": "^7.0.0",
    "del-cli": "^5.0.0",
    "eslint": "^8.30.0",
    "husky": "^8.0.2",
    "is-ci": "^3.0.1",
    "jest": "^29.3.1",
    "mkdirp": "^1.0.4",
    "prettier": "^2.8.1",
    "semantic-release": "^19.0.5",
    "tempy": "^3.0.0",
    "touch": "^3.1.0",
    "typescript": "^4.9.4"
  }
}
