{
  "name": "@unallocate/create",
  "version": "1.0.0",
  "description": "Create a TypeScript npm package or project",
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/bin/create.js",
  "files": [
    "dist",
    "skel"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc",
    "clean": "del *.tsbuildinfo coverage dist",
    "postinstall": "patch-package",
    "lint": "eslint *.js src skel",
    "prepack": "npm run build",
    "prepare": "is-ci || husky",
    "test": "cross-env NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --coverage",
    "tscc": "tsc --noEmit",
    "verify": "concurrently -c cyan,magenta,blue npm:lint npm:test npm:tscc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unallocate/create.git"
  },
  "author": {
    "name": "Eric McCarthy",
    "email": "eric@limulus.net",
    "url": "https://limulus.net/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/unallocate/create/issues"
  },
  "homepage": "https://github.com/unallocate/create#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@danieldietrich/copy": "^0.4.2",
    "@sindresorhus/is": "^7.0.1",
    "mustache": "^4.2.0",
    "patch-package": "^8.0.0",
    "simple-git": "^3.26.0",
    "tslib": "^2.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@limulus/eslint-config": "^5.1.0",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/mustache": "^4.2.5",
    "@types/node": "^22.13.10",
    "@types/nodegit": "^0.28.7",
    "@types/touch": "^3.1.5",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "del": "^7.1.0",
    "del-cli": "^5.1.0",
    "eslint": "^8.52.0",
    "husky": "^9.1.6",
    "is-ci": "^3.0.1",
    "jest": "^29.7.0",
    "mkdirp": "^3.0.1",
    "semantic-release": "^24.1.1",
    "tempy": "^3.1.0",
    "touch": "^3.1.1",
    "typescript": "^5.8.2"
  }
}
